<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Flink 作业：离线批处理 + 实时流处理（Flink 1.17.2，Java 8）。

    - OfflineJob  ：日文件 → 校验 → dwd / 离线指标（替代 etl.py）
    - RealtimeJob ：Kafka → 校验 → dwd / 死信（替代 realtime 的 Spring 消费）

    ⚠️ 这是**独立 Maven 工程**，不是 Spring Boot 模块：
       不继承 spring-boot-starter-parent，也不引任何 Spring 依赖。
       Flink 的依赖树与 Spring Boot 冲突面很大（Jackson / 日志 / Netty），
       硬塞进业务服务会绕回依赖地狱——这条与文档里 `offline` 独立 jar
       的约束是同一个理由，只是换了引擎。

    ⚠️ 运行 JDK 是 8：Flink 1.17.2 官方支持 Java 8 / 11，Java 17 要到
       1.18 才正式支持。本模块按 Java 8 编译，在 JDK 8 上运行；
       业务侧两个 Spring Boot 工程仍然是 JDK 17，互不影响。

    打包：
      mvn -DskipTests package            # 默认把 Flink 打进 fat jar，可本地跑
      mvn -Pcluster -DskipTests package  # 集群提交用，Flink 核心与日志改为 provided
  -->
  <groupId>com.demo01</groupId>
  <artifactId>flink-job</artifactId>
  <version>0.1.0</version>
  <name>demo01-flink-job</name>
  <description>P1 电信用户行为分析 · Flink 离线批处理作业</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <flink.version>1.17.2</flink.version>
    <!-- 默认 compile：本地 java -jar 直接跑；-Pcluster 时改为 provided -->
    <flink.scope>compile</flink.scope>
    <!-- 集群自带 log4j2 绑定，本地才需要 slf4j-simple -->
    <slf4j.scope>compile</slf4j.scope>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-runtime</artifactId>
      <version>${flink.version}</version>
      <scope>${flink.scope}</scope>
    </dependency>

    <!-- 实时作业的 Kafka source。版本与 Flink 小版本严格对应。 -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${flink.version}</version>
    </dependency>

    <!-- 日志行解析。Flink 自带的是 shaded Jackson（不同包名），不冲突。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.15.4</version>
    </dependency>

    <!-- 结果写 MySQL。与业务侧同一个本地库。 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>

    <!-- Flink 只带 slf4j-api，没有实现；本地跑给一个最简实现即可。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
      <scope>${slf4j.scope}</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.demo01.flink.OfflineJob</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>cluster</id>
      <properties>
        <flink.scope>provided</flink.scope>
        <slf4j.scope>provided</slf4j.scope>
      </properties>
    </profile>
  </profiles>
</project>
